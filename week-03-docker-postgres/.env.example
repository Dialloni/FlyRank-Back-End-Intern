# Copy to .env and fill in. .env is gitignored; this example is committed.
# Postgres image reads these to create the database on first boot:
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# The app reads this. Host "db" is the compose service name (use "localhost"
# when running the app outside Docker against a published port).
DATABASE_URL=postgresql://taskuser:change-me@db:5432/tasks

# postgres (default) or memory
REPO_BACKEND=postgres
